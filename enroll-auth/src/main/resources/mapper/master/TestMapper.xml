<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.gaogle.auth.dao.master.TestMapper">
    <resultMap type="top.gaogle.pojo.model.auth.TestModel" id="TestMap">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="age" column="age" jdbcType="INTEGER"/>
        <result property="price" column="price" jdbcType="INTEGER"/>
        <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
        <result property="createAt" column="create_at" jdbcType="INTEGER"/>
        <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
        <result property="updateAt" column="update_at" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="sqlAllColumns">
        id
        , name,age, price,create_by,create_at,update_by,update_at
    </sql>
    <insert id="insert">
        insert into test_auth(<include refid="sqlAllColumns"/>)
        values
        (#{id},#{name},#{age},#{price},#{createBy},#{createAt},#{updateBy},#{updateAt})
    </insert>

    <delete id="deleteById">
            delete from test_auth where id = #{id}
    </delete>

    <select id="selectByPageAndCondition" resultMap="TestMap">
        select
        <include refid="sqlAllColumns"/>
        from test_auth
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="name != null">
                and name = #{name}
            </if>
        </where>
        ORDER BY
        <choose>
            <when test='sort == null or sort.trim == ""'>
                create_at DESC
            </when>
            <otherwise>
                `${sort}`
                <choose>
                    <when test='order != null and "DESC".equalsIgnoreCase(order.trim())'>
                        DESC
                    </when>
                    <otherwise>
                        ASC
                    </otherwise>
                </choose>
            </otherwise>
        </choose>
    </select>


</mapper>